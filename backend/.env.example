NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dali
# Used by `npm test`. The tests wipe this database, so never point it at real data.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/dali_test
# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the storefront, used in password-reset links.
CLIENT_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Where uploaded files live, outside the app and Docker. Organised automatically.
UPLOAD_DIR=/file/dali
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
# Email for password resets. Without SMTP_URL, development writes messages to the log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Dali <no-reply@example.com>
# Admin account created by `npm run seed`.
SEED_ADMIN_EMAIL=admin@dali.local
SEED_ADMIN_PASSWORD=change-me-admin-password
