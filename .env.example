# Settings for production with Docker. ./run.sh prod creates .env with random secrets.
# Local development uses backend/.env instead. Never commit either file.

# Public address. Use https:// with DOMAIN set in production.
CLIENT_URL=http://localhost:8080
# Set to enable automatic HTTPS. Its DNS must point to this server, with ports 80 and 443 open.
DOMAIN=
# true behind HTTPS. false only for trying it over http://localhost.
COOKIE_SECURE=false
WEB_PORT=8080

# Long random values. Letters and digits only for MONGO_PASSWORD, as it goes in a URL.
JWT_ACCESS_SECRET=
MONGO_USERNAME=dali
MONGO_PASSWORD=

# Folders on the server. Keep DB_DIR outside FILES_DIR, which is served publicly.
FILES_DIR=/file/dali
DB_DIR=/file/dali-db
# User id that owns both folders.
FILES_UID=1000

# Email for password resets. Customers cannot reset passwords until this is set.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Dali <no-reply@example.com>

# First admin, created by ./run.sh admin. Use at least 12 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
